<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="architecture" name="Page-1"><mxGraphModel page="1" pageWidth="1120" pageHeight="1090" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AI 自交付 · 整体架构&#10;职责分层 × 交付过程 × 证据反馈" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#172b4d;strokeColor=#cbd5e1;fontColor=#ffffff;fontSize=26;fontFamily=Arial;spacing=12;fontStyle=1;"><mxGeometry as="geometry" x="30" y="20" width="1060" height="85" /></mxCell><mxCell id="l1" value="01  目标与决策&#10;人 / 组织：目标、验收、关键取舍、授权；AI：准备选项与影响依据" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7e6;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=12;fontStyle=1;"><mxGeometry as="geometry" x="45" y="135" width="800" height="100" /></mxCell><mxCell id="l2" value="02  交付组织&#10;依赖与协作 · 阶段推进 · 变更影响 · 阻塞与恢复" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=12;fontStyle=1;"><mxGeometry as="geometry" x="45" y="275" width="800" height="90" /></mxCell><mxCell id="process" value="九阶段责任（过程视角，不与四层一一对应）&#10;问题发现 → 产品定义 → 体验设计 → 技术与数据设计&#10;任务组织与授权 → 实现与集成 → 验证与待审 → 发布与运行 → 价值复盘&#10;可合并、并行、复用；按依赖推进，按原因回退" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=18;fontFamily=Arial;spacing=12;fontStyle=0;"><mxGeometry as="geometry" x="65" y="385" width="760" height="135" /></mxCell><mxCell id="l3" value="03  专业能力&#10;Agent 承担判断与协作；Skill 提供可复用方法&#10;产品 · 设计 · 工程 · 验证 · 运行 · 价值分析" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdfa;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=12;fontStyle=1;"><mxGeometry as="geometry" x="45" y="560" width="800" height="110" /></mxCell><mxCell id="l4" value="04  执行与证据&#10;工具实施动作 → 形成产物 → 观察实际结果 → 支持有限范围的结论&#10;关联对象、版本、环境与覆盖范围" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=20;fontFamily=Arial;spacing=12;fontStyle=1;"><mxGeometry as="geometry" x="45" y="715" width="800" height="115" /></mxCell><mxCell id="knowledge" value="贯穿各层的知识&#10;&#10;来源与适用范围&#10;当前约定优先&#10;&#10;读取已有知识&#10;↓&#10;形成本轮产物&#10;↓&#10;提炼候选经验&#10;↓&#10;审核与适用评估&#10;↓&#10;共享 / 修订 / 撤回&#10;&#10;知识积累不保证收益" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=19;fontFamily=Arial;spacing=12;fontStyle=0;"><mxGeometry as="geometry" x="890" y="135" width="200" height="695" /></mxCell><mxCell id="a" value="目标与有效授权" edge="1" parent="1" source="l1" target="l2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontColor=#64748b;fontSize=15;labelBackgroundColor=#ffffff;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b" value="按需组织能力" edge="1" parent="1" source="process" target="l3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontColor=#64748b;fontSize=15;labelBackgroundColor=#ffffff;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c" value="调用工具并核对结果" edge="1" parent="1" source="l3" target="l4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontColor=#64748b;fontSize=15;labelBackgroundColor=#ffffff;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="feedback" value="证据 / 偏差 → 复核与新决定" edge="1" parent="1" source="l4" target="l1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;strokeColor=#0f766e;fontColor=#0f766e;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="states" value="四种判断分别成立&#10;工程验证：符合检查条件  ｜  用户验收：被接受&#10;发布运行：目标环境中的实际状态  ｜  价值观察：是否产生收益" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7e6;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=20;fontFamily=Arial;spacing=12;fontStyle=0;"><mxGeometry as="geometry" x="45" y="875" width="1045" height="105" /></mxCell><mxCell id="note" value="理论草案：分层与阶段是设计选择；图中能力不代表已经实现。&#10;实线表示工作依据与调用关系，虚线表示反馈；知识为跨层资源，不是第五层。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=17;fontFamily=Arial;spacing=12;fontStyle=0;"><mxGeometry as="geometry" x="45" y="1000" width="1045" height="65" /></mxCell></root></mxGraphModel></diagram></mxfile>