<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="overview" name="AI 研发体系"><mxGraphModel page="1" pageWidth="1200" pageHeight="890" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AI 研发体系&#10;编码任务 → 研发组织 → 交付闭环 → 平台承载" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#172b4d;strokeColor=#cbd5e1;fontColor=#ffffff;fontSize=28;fontFamily=Arial;spacing=14;fontStyle=1;"><mxGeometry as="geometry" x="30" y="25" width="1140" height="95" /></mxCell><mxCell id="legend" value="阅读与建设路径：前两步扩展关注范围，最后一步切换到平台承载视角。&#10;不是固定成熟度等级；各主题可以同时存在、相互反馈。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=20;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="30" y="140" width="1140" height="75" /></mxCell><mxCell id="coding" value="01  AI coding&#10;&#10;怎样做好编码任务？&#10;&#10;上下文 · 任务拆分&#10;实现 · 诊断&#10;测试 · 审阅&#10;&#10;关注：可检查的变更" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="30" y="260" width="255" height="255" /></mxCell><mxCell id="native" value="02  AI Native&#10;&#10;怎样组织持续研发？&#10;&#10;人机分工 · 契约&#10;工程结构 · 知识&#10;质量 · 团队协作&#10;&#10;关注：研发条件" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f0fdfa;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="325" y="260" width="255" height="255" /></mxCell><mxCell id="delivery" value="03  AI 自交付&#10;&#10;怎样形成交付闭环？&#10;&#10;目标 · 验收 · 授权&#10;阶段协作 · 证据&#10;反馈 · 完成边界&#10;&#10;关注：交付责任" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff7e6;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="620" y="260" width="255" height="255" /></mxCell><mxCell id="platform" value="04  AI 研发&#10;Agent 平台&#10;&#10;怎样统一承载与治理？&#10;&#10;项目 · 任务 · 能力&#10;上下文 · 工具 · 证据&#10;&#10;关注：组织与追溯" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="915" y="260" width="255" height="255" /></mxCell><mxCell id="read1" source="coding" target="native" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#64748b;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="read2" source="native" target="delivery" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#64748b;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="read3" source="delivery" target="platform" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#64748b;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="support" value="平台可以承载前三类工作，不要求先完成前三步再建设。&#10;没有统一平台也可组织交付；拥有平台不代表编码正确、交付可靠或价值实现。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f0fdfa;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=21;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="30" y="605" width="1140" height="90" /></mxCell><mxCell id="carrier" source="platform" target="support" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#0f766e;dashed=1;exitX=0.5;exitY=1;entryX=0.89;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="supports-coding" source="support" target="coding" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#0f766e;dashed=1;exitX=0.11;exitY=0;entryX=0.5;entryY=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="supports-native" source="support" target="native" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#0f766e;dashed=1;exitX=0.37;exitY=0;entryX=0.5;entryY=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="supports-delivery" source="support" target="delivery" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#0f766e;dashed=1;exitX=0.63;exitY=0;entryX=0.5;entryY=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="boundary" value="贯穿所有主题的判断边界&#10;执行能力 ≠ 决策授权  ｜  验证通过 ≠ 全面正确  ｜  验收接受 ≠ 价值实现&#10;实线：阅读顺序；虚线：平台承载关系。图示为概念模型，不代表能力已经实现。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172b4d;fontSize=20;fontFamily=Arial;spacing=14;fontStyle=0;"><mxGeometry as="geometry" x="30" y="740" width="1140" height="110" /></mxCell></root></mxGraphModel></diagram></mxfile>