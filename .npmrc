# pnpm 配置
#
# shamefully-hoist=true：把间接依赖也 hoist 到顶层 node_modules。
# 主要原因：mermaid 11.x 的 ESM 通过裸模块名 `import dayjs from "dayjs"`
# 引用间接依赖（dayjs / @braintree/sanitize-url / debug / cytoscape*），
# pnpm 默认严格模式下这些包只在 .pnpm/ 深层，浏览器加载模块会失败并让
# Vue 应用崩溃（页面空白）。对本项目（文档站）而言，严格性带来的
# "防幽灵依赖" 收益小于配置复杂度，直接 hoist 更简单可靠。
shamefully-hoist=true
